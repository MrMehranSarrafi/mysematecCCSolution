<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- App Favicon -->
    <link rel="shortcut icon" href="~/assets/images/favicon.ico" />

    <!-- App CSS -->
    <link rel="stylesheet"
          type="text/css"
          href="~/assets/css/bootstrap-rtl.min.css" />
    <link rel="stylesheet"
          type="text/css"
          href="~/assets/plugins/switchery/switchery.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/core.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/components.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/icons.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/pages.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/menu.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/responsive.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/calendar.css" />
    <link rel="stylesheet"
          type="text/css"
          href="~/assets/plugins/toastr/toastr.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/plugins/time-picker/timepicker.min.css" />
    <link rel="stylesheet" type="text/css" href="~/assets/css/codeprocess.panel.css" />
    <link rel="stylesheet" type="text/css" href="~/css/bootstrap-icons.min.css"><!--من خودم اضافه کردم-->
    <script src="~/assets/js/modernizr.min.js"></script>
    <title>مدیریت دسترسی ها</title>       
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="fixed-left">
    <div id="wrapper">
        <!-- Top Bar Start -->
        <div class="topbar">
            <!-- LOGO -->
            <div class="topbar-left">
                <a href="#" class="logo">پنل مدیریت</a>
            </div>

            <!-- Button mobile view to collapse sidebar menu -->
            <div class="navbar navbar-default" role="navigation">
                <div class="container">
                    <!-- Page title -->
                    <ul class="nav navbar-nav navbar-left">
                        <li>
                            <button class="button-menu-mobile open-left">
                                <i class="zmdi zmdi-menu"></i>
                            </button>
                        </li>
                        <li>
                            <h4 class="page-title">  @ViewBag.PageTitle    </h4> 
                            @* <h4 class="page-title"> صفحه اصلی  </h4>page-title *@
                        </li>
                    </ul>
                    <ul class="nav navbar-nav navbar-right" style="display: none">
                        <li>
                            <!-- Notification -->
                            <div class="notification-box">
                                <ul class="list-inline m-b-0">
                                    <li>
                                        <a href="javascript:void(0);" class="right-bar-toggle">
                                            <i class="zmdi zmdi-notifications-none"></i>
                                        </a>
                                        <div class="noti-dot">
                                            <span class="dot"></span>
                                            <span class="pulse"></span>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <!-- End Notification bar -->
                        </li>
                        <li class="hidden-xs">
                            <form role="search" class="app-search">
                                <input type="text"
                                       placeholder="جستجو..."
                                       class="form-control" />
                                <a href="/panel/user/siteuser">
                                    <i class="fa fa-search"></i>
                                </a>
                            </form>
                        </li>
                    </ul>
                    <!-- Right(Notification and Searchbox -->
                </div>
                <!-- end container -->
            </div>
            <!-- end navbar -->
        </div>
        <!-- Top Bar End -->
        <!-- ========== Left Sidebar Start ========== -->

        <div class="left side-menu">
            <div class="slimScrollDiv"
                 style="
            position: relative;
            overflow: hidden;
            width: auto;
            height: 813px;
          ">
                <div class="sidebar-inner slimscrollleft"
                     style="overflow: hidden; width: auto; height: 813px">
                    <!-- User -->
                    <div class="user-box">
                        <div class="user-img" style="display: none">
                            <a>
                                <img src="~/assets/images/users/avatar-1.jpg"
                                     alt="user-img"
                                     title="کاربر گرامی"
                                     class="img-circle img-thumbnail img-responsive" />
                            </a>
                            <div class="user-status offline">
                                <i class="zmdi zmdi-dot-circle"></i>
                            </div>
                        </div>
                        <h5> <a>@(User.Identity.IsAuthenticated? User.Identity.Name : "میهمان")</a><br /></h5>
                        <ul class="list-inline">
                            <li class="display-none">
                                <a>
                                    <i class="zmdi zmdi-settings"></i>
                                </a>
                            </li>
                            <li>
                                <a asp-area="" asp-controller="UserAccount" asp-action="Logout" class="text-custom" asp-route-returnUrl="@Url.Action("IndexNew", "Home", new { area = "" })" asp-route-ComeFrom="@Context.Request.Path">
                                    <i class="zmdi zmdi-power"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                   
                    <!-- End User -->
                    <!--- Sidemenu -->

                    <div id="sidebar-menu">
                        <ul>
                            <li class="text-muted menu-title">پنل مدیریت</li>
                            <li>
                               
                                <a asp-area="" asp-controller="Home" asp-action="IndexNew" class="waves-effect">
                                    <i class="fa fa-tachometer" aria-hidden="true"></i>
                                    <span> صفحه نخست </span>
                                </a>
                            </li>
                           <!-- 
                           <li class="has_sub" parent-menu="Setting">
                                <a class="waves-effect">
                                    <i class="fa fa-cogs" aria-hidden="true"></i>
                                    <span>تنظیمات سیستم</span><span class="menu-arrow"></span>
                                </a>
                                <ul class="list-unstyled">
                                   
                                    <li selected-menu="Permission">
                                        <a asp-action="Permissions" asp-controller="UserAccount" asp-area="">مجوز ها</a>
                                    </li>
                                    <li selected-menu="EmailHost">
                                        <a href="#">ایمیل</a>
                                    </li>
                                    <li selected-menu="SmsSetting">
                                        <a href="#">پیامک</a>
                                    </li>
                                    <li selected-menu="NotificationProject">
                                        <a href="#">سرور نوتیفیکیشن</a>
                                    </li>
                                </ul>
                            </li>
                             -->
                            <li class="has_sub" parent-menu="User">
                                <a  class="waves-effect">
                                    <i class="fa fa-user" aria-hidden="true"></i>
                                    <span> مدیریت کاربران </span><span class="menu-arrow"></span>
                                </a>
                                <ul class="list-unstyled">
                                    <li>
                                        <a asp-controller="UserAccount" asp-action="Profile">پروفایل</a>
                                    </li>
                                    <li>
                                        <a asp-controller="UserAccount" asp-action="Create">کاربر جدید</a>
                                    </li>
                                    <li>
                                        <a asp-controller="UserAccount" asp-action="Index">کاربران</a>
                                    </li>
                                    <li selected-menu="Permission">
                                        <a asp-action="Permissions" asp-controller="UserAccount" asp-area="">مجوز ها</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="has_sub" parent-menu="Crm">
                                <a class="waves-effect">
                                    <i class="fa fa-users" aria-hidden="true"></i>
                                    <span> مدیریت شرکت ها </span><span class="menu-arrow"></span>
                                </a>
                                <ul class="list-unstyled">
                                    <li>
                                        <a asp-area="" asp-controller="Company" asp-action="Create">شرکت جدید</a>
                                    </li>
                                    <li>
                                        <a asp-area="" asp-controller="Company" asp-action="Index">شرکت ها</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="has_sub" parent-menu="User">
                                <a class="waves-effect">
                                    <i class="fa fa-user" aria-hidden="true"></i>
                                    <span> مدیریت سازمان ها   </span><span class="menu-arrow"></span>
                                </a>
                                <ul class="list-unstyled">
                                    <li>
                                        <a asp-controller="Organization" asp-action="Create">سازمان جدید</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Organization" asp-action="Index">سازمان ها</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="has_sub" parent-menu="User">
                                <a class="waves-effect">
                                    <i class="fa fa-user" aria-hidden="true"></i>
                                    <span> مدیریت شخص ها   </span><span class="menu-arrow"></span>
                                </a>
                                <ul class="list-unstyled">
                                    <li>
                                        <a asp-controller="Person" asp-action="Create">شخص جدید</a>
                                    </li>
                                    <li>
                                        <a asp-controller="Person" asp-action="Index">شخص ها</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="has_sub" parent-menu="Shop">
                                <a class="waves-effect">
                                    <i class="fa fa-shopping-bag" aria-hidden="true"></i>
                                    <span> مدیریت سفارش کارت ها </span><span class="menu-arrow"></span>
                                </a>
                                <ul class="list-unstyled">
                                    <li>
                                        <a href="/CardsManagement/CardOrderCreate">سفارش کارت جدید</a>
                                    </li>
                                    <li>
                                        <a asp-area="" asp-controller="CardsManagement" asp-action="CardOrderIndex">سفارش کارت ها</a>
                                    </li>
                                     
                                </ul>
                            </li>
                            <li>

                                <a asp-area="" asp-controller="CardsManagement" asp-action="CardsList" class="waves-effect">
                                    <i class="fa fa-tachometer" aria-hidden="true"></i>
                                    <span> جستجوی کارت ها </span>
                                </a>
                            </li>
                        </ul>
                        <div class="clearfix"></div>
                    </div>
                    <!-- Sidebar -->
                    <div class="clearfix"></div>
                </div>
                <div class="slimScrollBar"
                     style="
              background: rgb(220, 220, 220);
              width: 5px;
              position: absolute;
              top: 0px;
              opacity: 0.4;
              display: none;
              border-radius: 7px;
              z-index: 99;
              left: 1px;
              height: 813px;
              visibility: visible;
            "></div>
                <div class="slimScrollRail"
                     style="
              width: 5px;
              height: 100%;
              position: absolute;
              top: 0px;
              display: none;
              border-radius: 7px;
              background: rgb(51, 51, 51);
              opacity: 0.2;
              z-index: 90;
              left: 1px;
            "></div>
            </div>
        </div>

        <!-- Left Sidebar End -->
        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="content-page">
            <!-- Start content -->
            <div class="content">
                <div class="container">
                    <div class="row">
                        <form action="#"
                              data-ajax="true"
                              data-ajax-method="POST"
                              id="form0"
                              method="post">
                            <div class="col-sm-12">
                                <div class="card-box">
                                    <a href="#"
                                       class="icon circle-icon glyphicon glyphicon-arrow-left"
                                       data-toggle="tooltip" data-placement="bottom"
                                       title=""
                                       data-original-title="بازگشت"
                                    onclick="history.back()"></a>
                                    <div class="col-sm-12">


                                        @if (TempData["SuccessMessage"] != null)
                                        {
                                            <div class="alert alert-success alert-dismissible fade in" role="alert">
                                                @TempData["SuccessMessage"]
                                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                        }

                                        @if (TempData["ErrorMessage"] != null)
                                        {
                                            <div class="alert alert-danger alert-dismissible fade in" role="alert">
                                                @TempData["ErrorMessage"]
                                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                        }

                                        @RenderBody()

                                       @*  <main role="main" style="padding-bottom: 3px;">
                                            @RenderBody()
                                        </main> *@
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- End row -->
                </div>
                <!-- container -->
            </div>
            <!-- content -->
            <footer class="footer">
                <a class="english-only" href="http://givsoft.ir/">GIVSOFT.IR-2017-ALL RIGHTS RESERVED</a>
            </footer>
        </div>
        <!-- End content-page -->
    </div>
