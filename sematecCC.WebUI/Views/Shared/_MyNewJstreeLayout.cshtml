    <script type="text/javascript" src="~/assets/js/jquery.min.js"></script> من
    <script type="text/javascript" src="~/assets/js/bootstrap-rtl.min.js"></script>
   @*  <script type="text/javascript" src="~/assets/js/jquery.core.js"></script>
    <script type="text/javascript" src="~/assets/js/jquery.app.js"></script> *@
    <script>
        $(document).ready(function () {
          $("#sidebar-menu li.has_sub > a.waves-effect").click(function () {
            $(this).toggleClass("subdrop");
            $(this).parent().find("ul.list-unstyled").slideToggle(300);
          });
        });
    </script>
    <script>
        $(document).ready(function() {
            setTimeout(function() {
                $(".alert").fadeOut("slow");
            }, 5000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>