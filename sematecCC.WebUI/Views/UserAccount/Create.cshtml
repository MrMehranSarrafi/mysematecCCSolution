@model CreateUserViewModel
@{
    ViewData["Title"] = "ایجاد کاربر جدید";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "_LayoutNew";//اگر مسیر فایل _Layout.cshtml در همان پوشه Views/Shared باشد،
                          // Layout = "~/Views/Shared/_Layout.cshtml";//اگر فایل در مسیر دیگری قرار دارد
    ViewBag.PageTitle= " کاربر جدید";
}

@* <h2>@ViewData["Title"]</h2> *@
@section HeaderUpLeftIcons {
    <a onclick="history.back()" class="icon circle-icon glyphicon glyphicon-arrow-left" data-toggle="tooltip" data-placement="bottom" title="بازگشت"></a>
}
<form asp-action="Create" method="post" asp-antiforgery="true">
    <div class="form-group">
        <label asp-for="FirstName" class="control-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="LastName" class="control-label required"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CompanyId" class="control-label required">  شرکت</label>

        @* <div class="row"> *@
            <!-- کمبو سمت راست -->
            @* <div class="col-6"> *@
                <select asp-for="CompanyId"
                        asp-items="ViewBag.Companies"
                        class="form-select "
                        id="CompanyId">
                    @if(ViewBag.IsAdmin)
                    {
                    <option value="">انتخاب کنید</option>
                        
                    }
                </select>
            @* </div> *@

            <!-- تکست‌باکس سمت چپ -->
           @*  <div class="col-6">
                <input type="hidden" class="form-control" asp-for="CompanyCode" id="CompanyCode" readonly />
            </div> *@
        @* </div> *@

        <span asp-validation-for="CompanyId" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label asp-for="Telephone" class="control-label"></label>
        <input asp-for="Telephone" class="form-control"
               placeholder="مثال: 021-12345678"
                 />
        <span asp-validation-for="Telephone" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="UserName" class="control-label required"></label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PhoneNumber" class="control-label required"></label>
        <input asp-for="PhoneNumber" class="form-control"
               placeholder="مثال: 09123456789"
                />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password" class="control-label required"></label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ConfirmPassword" class="control-label required"></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">ایجاد کاربر</button>
        @* <button asp-action="Index" class="btn btn-secondary">لیست کاربران  </button> //needs validation!*@
        <a asp-action="Index" class="btn btn-secondary" style="background: aliceblue;">لیست کاربران</a>
        <button type="button" class="btn btn-secondary" onclick="history.back()">بازگشت</button>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>
</form>
@section Styles {
    <link href="~/css/tom-select.css" rel="stylesheet">
    <style>
        .required:after {
            content: " *";
            color: #dc3545;
        }
       
    </style>
}
 
@section Scripts {
    
        @await Html.PartialAsync("_ValidationScriptsPartial")
        <script src="~/js/tom-select.complete.min.js" defer></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // --- TomSelect ها ---
            const companySelect = new TomSelect("#CompanyId", {
                create: false,
                placeholder: "جستجو و انتخاب شرکت...",
                maxOptions: 1000,
                allowEmptyOption: true
            });

           
            
        });
        document.ready(function(){
             // فرمت خودکار تلفن
             $('#Telephone').on('input', function() {
                 let value = $(this).val().replace(/[^0-9\+\-\(\)\s]/g, '');
                 $(this).val(value);
             });

             // فرمت خودکار موبایل
             $('#PhoneNumber').on('input', function() {
                 let value = $(this).val().replace(/[^0-9]/g, '');
                 if (value.length > 11) {
                     value = value.substring(0, 11);
                 }
                 $(this).val(value);
             });
        });
    </script>
     
     
}