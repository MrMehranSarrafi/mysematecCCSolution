@using Core.Domain.Entities
@model Permissiongroup
@{
    Layout = "_LayoutNew";
    ViewData["Title"] = "ویرایش گروه مجوزها";
    ViewBag.PageTitle = "ویرایش گروه مجوزها";
}

<div class="container" style="margin-top: 20px;">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-building"></i> @ViewData["Title"]
                    </h3>
                </div>

                <div class="panel-body">
                    <form asp-action="PermissionGroupEdit" method="post" id="editPerGrForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" id="Id" value="@Model.Id" />

                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="Name" class="required"></label>
                                    <input asp-for="Name" class="form-control"
                                           autofocus />
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <!-- توضیحات -->
                            <div class="col-md-12">
                                <div class="form-group">
                                    <label asp-for="Description"></label>
                                    <textarea asp-for="Description" class="form-control"
                                              rows="4"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                        <div asp-validation-summary="All"
                             class="alert alert-danger @(ViewData.ModelState.IsValid ? "hidden" : "")"
                             style="margin-top: 15px;"
                             id="validationSummary">
                        </div>

                        <!-- دکمه‌ها -->
                        <div class="form-group" style="margin-top: 20px;">
                            <div class="text-center">
                                <button type="submit" class="btn btn-success" id="btnSubmit" style="padding-left: 20px; padding-right: 20px; margin-left: 5px;">
                                    <i class="fa fa-save"></i> ذخیره
                                </button>

                                <a asp-action="PermissionGroupIndex" class="btn btn-default" style="padding-left: 20px; padding-right: 20px; margin-right: 5px;">
                                    <i class="fa fa-arrow-left"></i> بازگشت به لیست
                                </a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .required:after {
            content: " *";
            color: #dc3545;
        }

        .panel {
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            border-radius: 4px;
        }

        .panel-heading {
            background-color: #337ab7;
            color: white;
            border-top-left-radius: 3px;
            border-top-right-radius: 3px;
        }

        .form-control:focus {
            border-color: #66afe9;
            outline: 0;
            box-shadow: inset 0 1px 1px rgba(0,0,0,0.075), 0 0 8px rgba(102, 175, 233, 0.6);
        }

        /* برای RTL */
        .form-control[dir="ltr"] {
            text-align: left;
            direction: ltr;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .row {
            margin-bottom: 10px;
        }

        .fa {
            margin-left: 5px;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function() {
           

            // جلوگیری از ارسال دوباره فرم
            $('#editPerGrForm').on('submit', function() {
                const form = this;

                // بررسی اعتبارسنجی کلاینت‌ساید (jQuery Unobtrusive)
                if (!$(form).valid()) {
                    return;
                }

                $('#btnSubmit').prop('disabled', true)
                    .html('<i class="fa fa-spinner fa-spin"></i> در حال ذخیره...');
            });

            // فعال کردن کلیک Enter برای فیلدها
            $('input, textarea').keydown(function(e) {
                if (e.keyCode === 13 && !$(this).is('textarea')) {
                    e.preventDefault();
                    var inputs = $(this).closest('form').find(':input:visible');
                    var next = inputs.eq(inputs.index(this) + 1);
                    if (next.length) {
                        next.focus();
                    } else {
                        $(this).closest('form').submit();
                    }
                }
            });
        });
    </script>
}