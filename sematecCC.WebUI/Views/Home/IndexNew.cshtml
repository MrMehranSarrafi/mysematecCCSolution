@using Core.Enums
@using SematecCC.WebUI
@{
    ViewData["Title"] = "صفحه اصلی";
    ViewBag.PageTitle = "صفحه اصلی";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    // Layout = "_LayoutNew";
}
@section Styles {
    <style>
        a {
            display: inline-block;
            margin-bottom: 2px !important;
        }
    </style>
}

