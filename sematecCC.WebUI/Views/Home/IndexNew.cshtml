</div>-->
<div class="row">
    <br />
    <br />
    <br />
    <br />
    
    @* @if (User.HasClaim("Permission",UserPermissionsEnum.CompanyList.ToString())) *@
    @if (User.HasPermission(UserPermissionsEnum.CompanyList))
    {
        <a class="btn btn-success" asp-action="Index" asp-controller="Company">لیست شرکت ها</a>

    }
    @if (User.HasPermission(UserPermissionsEnum.UserAccountList))
    {
        <a class="btn btn-success" asp-action="Index" asp-controller="UserAccount">لیست کاربران</a>

    }
    @if (User.HasPermission(UserPermissionsEnum.OrganizationList))
    {
    <a class="btn btn-success" asp-action="Index" asp-controller="Organization">لیست سازمان ها</a>

    }
    @if (User.HasPermission(UserPermissionsEnum.PersonList))
    {
    <a class="btn btn-success" asp-action="Index" asp-controller="Person">لیست اشخاص</a>
    }
    @if (User.HasPermission(UserPermissionsEnum.CardOrderList))
    {
    <a class="btn btn-success" asp-action="CardOrderIndex" asp-controller="CardsManagement">لیست سفارش کارت ها</a>
    }
    @if (User.HasPermission(UserPermissionsEnum.CardOrderDetailsView))
    {
    <a class="btn btn-success" asp-action="CardsList" asp-controller="CardsManagement">جستجوی کارت ها</a>
    }
   

</div>
