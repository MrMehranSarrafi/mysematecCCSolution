@using SematecCC.Core
@model CardOrder
<!-- ✅ مقداردهی اولیه hidden field -->
@{
    string savedTedad = TempData["CardOrder_Tedad"]?.ToString() ?? "";
    string savedCompanyId = TempData["CardOrder_CompanyId"]?.ToString() ?? "";
    string savedAmount = TempData["CardOrder_Amount"]?.ToString() ?? "";
    //string savedDescription = TempData["CardOrder_Description"]?.ToString() ?? "";
}
@{
    Layout = "_LayoutNew";
    ViewBag.PageTitle = "ویرایش سفارش کارت";
}
@{
    var hasSetExpireDateFaPermission = User.HasPermission(UserPermissionsEnum.CardOrderSetAllCardsExpireDate);
}
<form asp-action="CardOrderEdit" method="post" asp-antiforgery="true">

    <div class="row">
        <div class="col-xs-6">
            <div class="form-group">
                <label asp-for="Tedad" class="form-label">تعداد کارت</label>
                @if (string.IsNullOrWhiteSpace(savedAmount))
                {
                    <input type="number" asp-for="Tedad" class="form-control" />
                }
                else
                {
                    <input type="number" asp-for="Tedad" value="@savedTedad" class="form-control" />

                }
                <span asp-validation-for="Tedad" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xs-6">
            <div class="form-group">
                <label asp-for="CompanyId" class="control-label">شرکت</label>
                <select class="form-select" asp-for="CompanyId" >
                    @if (ViewBag.IsAdmin)
                    {
                        <option value="">انتخاب کنید</option>
                    }

                    @if (string.IsNullOrWhiteSpace(savedCompanyId))
                    {
                        @foreach (var company in ViewBag.Companies)
                        {
                            var isSelected = company.Value == Model.CompanyId.ToString();
                            <option value="@company.Value" selected="@isSelected">
                                @company.Text
                            </option>
                        }
                    }
                    else
                    {
                        @foreach (var company in ViewBag.Companies)
                        {
                            var isSelected = company.Value == savedCompanyId?.ToString();
                            <option value="@company.Value" selected="@isSelected">
                                @company.Text
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-6">
            <div class="form-group">
                <label asp-for="Amount" class="control-label"> مبلغ   </label>
                @if (string.IsNullOrWhiteSpace(savedAmount))
                {
                    <input type="number" asp-for="Amount" value="@Model.Amount.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" />
                }
                else
                {
                    <input type="number" asp-for="Amount" value="@savedAmount" class="form-control" />
                }
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
        </div>
        <div class="col-xs-5 ">
            <div class="form-group">
                <label asp-for="OrganizationId" class="control-label"> سازمان   </label>

                <select asp-for="OrganizationId" class="form-select">
                    <option value="">انتخاب کنید</option>
                    @{
                        // 1. مقدار پیش‌فرض را از مدل می‌گیریم
                        var selectedOrgId = Model.OrganizationId;

                        // 2. اگر مقدار در TempData وجود داشت، اولویت با آن است (برای حفظ انتخاب کاربر بعد از رفرش یا خطا)
                        if (!string.IsNullOrWhiteSpace(TempData["SelectedOrganizationId"]?.ToString()))
                        {
                            if (int.TryParse(TempData["SelectedOrganizationId"].ToString(), out int tempId))
                            {
                                selectedOrgId = tempId;
                            }
                        }
                    }
                    @foreach (var org in ViewBag.Organizations)
                    {
                        // 3. بررسی اینکه آیا این گزینه با مقدار نهایی (Model یا TempData) برابر است؟
                        bool isSelected = org.Value == selectedOrgId.ToString();

                        <option value="@org.Value" selected="@isSelected">
                            @org.Text
                        </option>
                    }
                </select>
            </div>
        </div>
        <div class="col-xs-1">
            <div class="form-group">
                <label class="control-label ">&nbsp;</label>
                <a id="btnAddOrg" class="btn btn-success btn-sm" style="margin-top:25px;">+</a>
            </div>
        </div>
 
    <!-- ردیف سوم: تاریخ انقضا -->
    <div class="row">
        <div class="col-xs-12">
            <div class="form-group" style="margin-top: 3px;">
                <div class="d-flex align-items-center" style="display: flex; align-items: center;">
                    <div style="display: flex; align-items: center; margin-left: 15px;">
                            @if (hasSetExpireDateFaPermission)
                            {
                                <input asp-for="WillExpire" type="checkbox" class="form-check-input" id="WillExpire" />

                            }
                            else
                            {
                                <input asp-for="WillExpire" type="checkbox" class="form-check-input" id="WillExpire" disabled />

                            }
                        <label asp-for="WillExpire" class="form-check-label ms-2 mb-0" style="margin-right: 5px; margin-bottom: 0;">
                            دارای تاریخ انقضا می باشد
                        </label>
                    </div>
                    <div style="display: flex; align-items: center;">
                        <input asp-for="ExpireDayNumber" type="number" class="form-control" id="ExpireDayNumber"
                               style="width: 80px; margin-left: 5px;"   />
                        <span style="font-weight: bold; margin-right: 5px;">روز</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div class="form-group " style="margin-top:3px;">
                <label asp-for="Description" class="control-label">توضیحات</label>
                <textarea asp-for="Description" class="form-control"></textarea>
            </div>
        </div>
    </div>
     

    <div class="row">
        <div class="form-group  col-xs-12" style="margin-top:3px;">
            <button type="submit" class="btn btn-primary">ویرایش شماره کارت</button>
            <button type="button" class="btn btn-secondary" onclick="history.back()" style="background-color: darkgray;">لغو</button>
        </div>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</form>
@section Styles {
    <link href="~/css/tom-select.css" rel="stylesheet">
    <link rel="stylesheet" href="~/assets/css/font-awesome4.7.0.min.css" asp-append-version="true" />


}
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script src="~/js/tom-select.complete.min.js" defer></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentCardOrderId = @Model.Id;

            // --- TomSelect ها ---
            const companySelect = new TomSelect("#CompanyId", {
                create: false,
                    placeholder: "جستجو و انتخاب شرکت...",
                    maxOptions: 1000,
                    allowEmptyOption: true
            });

            const organizationSelect = new TomSelect("#OrganizationId", {
                create: false,
                    placeholder: "جستجو و انتخاب سازمان...",
                    maxOptions: 1000,
                    allowEmptyOption: true
            });

           

            // هنگام تغییر
           

            document.getElementById('btnAddOrg').addEventListener('click', function(e)
            {
                e.preventDefault(); // جلوگیری از رفتن مستقیم
                
                // گرفتن مقادیر از فرم
                const tedad       = document.getElementById('Tedad').value;
                const companyId   = document.getElementById('CompanyId').value;
                const amount      = document.getElementById('Amount').value;
                const description = document.getElementById('Description').value;

                // ساخت URL
                //Create:   `/CardsManagement/CardOrderCreate?tedad=${tedad}&companyId=${companyId}&amount=${amount}&description=${encodeURIComponent(description)}`
                const returnUrl = encodeURIComponent(                     
                    `/CardsManagement/CardOrderEdit/${currentCardOrderId}?tedad=${tedad}&companyId=${companyId}&amount=${amount}`
                );

                const url = `/Organization/Create?returnUrl=${returnUrl}`;
                console.log(url);
                window.location.href = url;
            });

            const checkbox = document.getElementById('WillExpire');
            const inputNumber = document.getElementById('ExpireDayNumber');

            checkbox.addEventListener('change', RefreshExpirationInfo);
            RefreshExpirationInfo();
            function RefreshExpirationInfo()
            {
                if (checkbox.checked) {
                    // فعال‌سازی و پاک کردن
                    inputNumber.disabled = false;

                    inputNumber.focus();
                } else {
                    // غیرفعال‌سازی و پاک کردن
                    inputNumber.disabled = true;
                    inputNumber.value = '';
                }
            }

        });
    </script>
}


