@model IEnumerable<PermissiongroupDto>

@{
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    ViewBag.PageTitle = $"افزودن کاربر {ViewBag.Username}  به گروه های مجوز ها  ";
}

<form asp-action="UserPermissiongroups" method="post">
 @* @using (Html.BeginForm()) { } *@

    <input type="hidden" name="userId" value="@ViewBag.userId" />
    <div class="row">
        <div class="card-box">
            <div class="dropdown pull-right">
                <a href="#" class="dropdown-toggle card-drop" data-toggle="dropdown" aria-expanded="false">
                    <i class="zmdi zmdi-more-vert"></i>
                </a>
                <ul class="dropdown-menu" role="menu">
                    @* <li>@Html.ActionLink("بازگشت", "Index")</li> *@
                    <li><a asp-action="Index">بازگشت </a></li>
                </ul>
            </div>
           @*  <div class="col-sm-12">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade in" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade in" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
            </div> *@
            <div class="col-sm-12">
                <div class="form-horizontal">

                    <div class="form-group">
                        @foreach (var item in Model)
                        {
                            <div class="permission-group-item">
                                @* <input  id="checkbox-@item.GroupId" type="checkbox" class="parent-box" checked="@item.IsSelected" name="PermissiongroupList" value="@item.GroupId" /> *@
                                @* <input id="checkbox-@item.GroupId" type="checkbox" class="parent-box" name="permissiongroupIds" value="@item.GroupId" @(item.IsSelected ? "checked" : "") /> *@
                                <input id="checkbox-@item.GroupId"
                                       type="checkbox"
                                       class="parent-box"
                                       name="permissiongroupIds"
                                       value="@item.GroupId"
                                       @(item.IsSelected ? "checked" : "") />

                                <label for="checkbox-@item.GroupId">
                                    @item.GroupName
                                </label>

                                <br />
                            </div>
                        }
                       
                    </div>

                    
                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input id="btnSubmit" type="submit" value="ثبت" class="btn btn-success" />
                            <span class="btn btn-inverse" onclick="history.back()">بازگشت</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</form>
@* 
در ASP.NET Core وقتی چند checkbox با یک name یکسان باشند:
اتوماتیک تبدیل می‌شود به:
int[] permissiongroupIds *@