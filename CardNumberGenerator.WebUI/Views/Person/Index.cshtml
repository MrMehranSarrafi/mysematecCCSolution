@model IEnumerable<PersonVM>
@{
    Layout = "_LayoutNew";
    ViewBag.PageTitle = "لیست اشخاص";
}
@{
   // Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "لیست اشخاص  ";
    var dummy = new PersonVM(); // نمونه موقتی
}
@section HeaderUpLeftIcons {

    <a href="@Url.Action("create")" class="icon circle-icon glyphicon glyphicon-plus" data-toggle="tooltip" data-placement="bottom" title="افزودن شخص جدید"></a>
}
<div class="container">
  @*   <h2 class="mb-4"> لیست اشخاص         </h2> *@
    <div id="messageDiv">
        @if (TempData["Message"] != null)
        {
            <h2>@TempData["Message"]</h2>
        }
    </div>
    <div id="Search">
       جستجو : <input type="text" id="txtSearch" style="margin-bottom:3px;" />

    </div>
    <div class="row">
        <div class="col">
            <table class="table table-bordered table-striped table-responsive">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>نام  </th>
                        <th>نام  خانوادگی</th>
                        <th>موبایل</th>
                        <th>تلفن</th>
                        <th>کد ملی</th>
                        <th>تاریخ تولد</th>
                        <th> محل کار  </th>                        
                        <th>@Html.DisplayNameFor(m => dummy.GivId)</th><!--<th>کد گیو</th>-->
                        <th>شرکت</th>

                        @* <th style="width: 180px;">عملیات</th> *@
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="tbody">
                    @foreach (var owner in Model)
                    {
                        <tr>
                            <td>@owner.Id</td>
                            <td>@owner.FirstName</td>
                            <td>@owner.LastName</td>
                            <td>@owner.Mobile</td>
                            <td>@owner.Phone</td>
                            <td>@owner.NationalCode</td>
                            <td>@owner.BirthDateFa</td>
                            <td>@owner.JobPlace</td>
                            <td>@owner.GivId</td>
                            <td>@owner.Company?.CompanyInfo</td>
                            <td colspan="3">
                                <a asp-action="Edit" asp-route-Id="@owner.Id" class="btn btn-sm btn-warning">ویرایش</a>
                                <a asp-action="Details" asp-route-personId="@owner.Id" class="btn btn-sm btn-secondary" style="background-color: white;">مشاهده</a>
                                <a></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</div>

<br />
<a asp-action="Create" class="btn btn-success">جدید</a>
<a asp-action="IndexNew" asp-controller="Home" class="btn btn-secondary" style="background-color: aliceblue;">خانه</a>

