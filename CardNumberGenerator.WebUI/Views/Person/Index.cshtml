        $(document).ready(function() {
            $("#txtSearch").on("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();

                    var value = $(this).val();
                    $.get("/Person/Search", { searchItems: value })
                        .done(function (data) {
                            if (!data || data.length === 0) {
                                $("#tbody").html("<td><td colspan='13'>موردی یافت نشد</td></tr>");
                                return;
                            }

                            var str = "";
                            for (var i = 0; i < data.length; i++) {
                                var o = data[i];
                                var personId = o.Id || o.id||o.personId|| o.PersonId;
                                str += "<tr>";
                                str += "<td>" + (o.id || "") + "</td>";
                                str += "<td>" + (o.firstName || "") + "</td>";
                                str += "<td>" + (o.lastName || "") + "</td>";
                                str += "<td>" + (o.mobile || "") + "</td>";
                                str += "<td>" + (o.phone || "") + "</td>";
                                str += "<td>" + (o.nationalCode || "") + "</td>";
                                str += "<td>" + (o.birthDateFa || "") + "</td>";
                                str += "<td>" + (o.jobPlace || "") + "</td>";
                                str += "<td>" + (o.givId || "") + "</td>";
                                str += "<td>" + ((o.company && o.company.companyInfo) || "") + "</td>";
                                str += '<td colspan="3">';
                                str += '<a href="/Person/Edit/' + personId + '" class="btn btn-sm btn-warning">ویرایش</a>';
                                str += '<a href="/Person/Details?personId=' +personId  + '" class="btn btn-sm btn-secondary" style="background-color: white;">مشاهده</a> <a></a> ';
                                str += "  </td>";
                                str += "</tr>";
                            }

                            $("#tbody").html(str);
                        })
                        .fail(function () {
                            alert("خطا در دریافت اطلاعات");
                        });
                }
            });
        });
    

