@* @model CurrentUserDto *@

<div class="user-box">
    <div class="user-img" style="display: none;">
        <a>
            <img src="~/assets/images/ManOrWoman.jpg" alt="user-img" title="@(User?.FindFirst("FullName")?.Value ?? "میهمان")" class="img-circle img-thumbnail img-responsive">
        </a>
        <div class="user-status offline"><i class="zmdi zmdi-dot-circle"></i></div>
    </div>
    <h5>
        @* <a>@Model.FullName</a> <br /> *@
        <a>@(User?.FindFirst("FullName")?.Value ?? "میهمان")</a>
    </h5>
    <ul class="list-inline">
        @if(User.Identity.IsAuthenticated)
        {
            <li class="display-none">
                <a href="@Url.Action("Profile", "UserAccount")" class="text-custom" title="پروفایل">
                    <i class="zmdi zmdi-settings"></i>
                </a>
            </li>
            <li>
                <a href="@Url.Action("LogOut", "UserAccount")" class="text-custom" title="خروج">
                    <i class="zmdi zmdi-power"></i>
                </a>
            </li>
        }
        else
        {
            <li class="display-none">
                <a href="@Url.Action("Login", "UserAccount")" class="text-custom" title="ورود">
                    <i class="zmdi zmdi-settings"></i>
                </a>
            </li>
        }
    </ul>
</div>
