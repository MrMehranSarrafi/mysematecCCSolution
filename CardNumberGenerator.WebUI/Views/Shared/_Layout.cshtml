<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه مدیریت کارت</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><!--version 5-->
    <link rel="stylesheet" href="~/css/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- منوی اصلی سمت راست -->
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">صفحه اصلی</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Company" asp-action="Create">شرکت جدید</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="UserAccount" asp-action="Create">کاربر جدید</a>
                                </li>
                            }

                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Organization" asp-action="Create">سازمان جدید</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Person" asp-action="Create">شخص جدید</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="CardsManagement" asp-action="CardOrderIndex"> لیست سفارش کارت ها</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="CardsManagement" asp-action="CardsList"> جستجوی کارت ها  ‌ </a>
                        </li>

                    </ul>


                    <!-- بخش احراز هویت سمت چپ -->
                    <ul class="navbar-nav me-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                                   style="display: flex; align-items: center; gap: 5px;">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-start shadow" aria-labelledby="userDropdown"
                                    style="min-width: 200px; margin-top: 5px; border-radius: 8px;">
                                    <li>
                                        <a class="dropdown-item py-2" asp-area="" asp-controller="UserAccount" asp-action="Profile">
                                            <i class="bi bi-person ms-2"></i> پروفایل
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger" asp-area="" asp-controller="UserAccount" asp-action="Logout"
                                           asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                           asp-route-ComeFrom="@Context.Request.Path">
                                            <i class="bi bi-box-arrow-right me-2"></i> خروج
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="UserAccount" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-left"></i> ورود
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="UserAccount" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> ثبت‌نام
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @await Html.PartialAsync("_AlertMessages")
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start">
                    &copy; @DateTime.Now.Year - سامانه مدیریت کارت -
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">حریم خصوصی</a>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span>ورژن 1.0</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>


    <!-- اضافه کردن آیکون‌های Bootstrap Icons برای زیبایی بیشتر -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>